# Copy this file to .streamlit/secrets.toml and put your own key in it.
# Get a free key at https://aistudio.google.com/apikey
# secrets.toml is listed in .gitignore, so your key never ends up on GitHub.
# On Streamlit Community Cloud, paste this line into Settings -> Secrets instead.
GEMINI_API_KEY = "paste-your-key-here"
